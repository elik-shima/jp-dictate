[
 {
  "file": "wav/v0_s00.wav",
  "voice": "Kyoko",
  "text": "明日の会議は午後三時からに変更になりました。",
  "sha256": "0fb97dd7d3d6ec48"
 },
 {
  "file": "wav/v0_s01.wav",
  "voice": "Kyoko",
  "text": "資料を確認して、修正点があれば連絡してください。",
  "sha256": "1ebaa38f176e3815"
 },
 {
  "file": "wav/v0_s02.wav",
  "voice": "Kyoko",
  "text": "来週の金曜日までに見積もりを送ります。",
  "sha256": "43c59d319de5f744"
 },
 {
  "file": "wav/v0_s03.wav",
  "voice": "Kyoko",
  "text": "今日はありがとうございました。引き続きよろしくお願いいたします。",
  "sha256": "e57b76959bc20a14"
 },
 {
  "file": "wav/v0_s04.wav",
  "voice": "Kyoko",
  "text": "新しいプロジェクトの予算について、クライアントと相談する必要があります。",
  "sha256": "a8043d816989aab7"
 },
 {
  "file": "wav/v0_s05.wav",
  "voice": "Kyoko",
  "text": "了解です。",
  "sha256": "528240320f904a2d"
 },
 {
  "file": "wav/v0_s06.wav",
  "voice": "Kyoko",
  "text": "少し遅れます、すみません。",
  "sha256": "94adca1fb1ca2554"
 },
 {
  "file": "wav/v0_s07.wav",
  "voice": "Kyoko",
  "text": "企画書のキービジュアルは、もう少し明るいトーンにしたいです。",
  "sha256": "249e95eed570a60f"
 },
 {
  "file": "wav/v0_s08.wav",
  "voice": "Kyoko",
  "text": "プレゼンの構成案をスラックで共有しました。",
  "sha256": "8f9dbe860382e638"
 },
 {
  "file": "wav/v0_s09.wav",
  "voice": "Kyoko",
  "text": "PDFで送ってもらえますか？",
  "sha256": "f85a76fd82fad130"
 },
 {
  "file": "wav/v0_s10.wav",
  "voice": "Kyoko",
  "text": "撮影のスケジュールは、十月の第二週で調整しています。",
  "sha256": "05db7e491a6e491c"
 },
 {
  "file": "wav/v0_s11.wav",
  "voice": "Kyoko",
  "text": "先方の担当者が変わったので、改めてご挨拶に伺います。",
  "sha256": "301d837b178cba5b"
 },
 {
  "file": "wav/v0_s12.wav",
  "voice": "Kyoko",
  "text": "その件については、社内で確認してから折り返しご連絡します。",
  "sha256": "2ea941bee0a63387"
 },
 {
  "file": "wav/v0_s13.wav",
  "voice": "Kyoko",
  "text": "ロゴの位置を右上に移動して、サイズを少し小さくしてください。",
  "sha256": "716f047145fd2b2d"
 },
 {
  "file": "wav/v0_s14.wav",
  "voice": "Kyoko",
  "text": "予算は五百万円で、納期は年内を想定しています。",
  "sha256": "492dac30b7bb692e"
 },
 {
  "file": "wav/v0_s15.wav",
  "voice": "Kyoko",
  "text": "なるほど、それはいいアイデアですね。",
  "sha256": "2c621d212cd5852d"
 },
 {
  "file": "wav/v0_s16.wav",
  "voice": "Kyoko",
  "text": "動画の尺は十五秒と三十秒の二パターンを用意してください。",
  "sha256": "c7f534ae9f5dc4eb"
 },
 {
  "file": "wav/v0_s17.wav",
  "voice": "Kyoko",
  "text": "ターゲットは二十代から三十代の女性です。",
  "sha256": "f171d108aacba6ab"
 },
 {
  "file": "wav/v0_s18.wav",
  "voice": "Kyoko",
  "text": "修正版をアップしたので、お手すきの際にご確認ください。",
  "sha256": "4ba9062722fa4f7c"
 },
 {
  "file": "wav/v0_s19.wav",
  "voice": "Kyoko",
  "text": "え、それって本当ですか？",
  "sha256": "22256cd9ef041a9e"
 },
 {
  "file": "wav/v0_s20.wav",
  "voice": "Kyoko",
  "text": "議事録は私のほうでまとめておきます。",
  "sha256": "0db2656df9e652a9"
 },
 {
  "file": "wav/v0_s21.wav",
  "voice": "Kyoko",
  "text": "競合他社の事例をいくつか調べて、比較表を作ってください。",
  "sha256": "4173528c289b7e2b"
 },
 {
  "file": "wav/v0_s22.wav",
